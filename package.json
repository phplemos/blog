{
  "name": "phplemos-blog",
  "version": "0.0.1",
  "description": "Source for phplemos.dev — a Hugo blog with Notion as the CMS",
  "main": "src/index.ts",
  "private": true,
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/phplemos/blog",
  "bugs": {
    "url": "https://github.com/phplemos/blog/issues"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=8"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "server": "hugo server -D --disableFastRender --noHTTPCache",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "Notion",
    "Hugo",
    "blog"
  ],
  "author": "Pedro Henrique Pinheiro Lemos",
  "dependencies": {
    "@notionhq/client": "^5.20.0",
    "dotenv": "^17.4.2",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.3.4",
    "markdown-table": "^3.0.4",
    "tsx": "^4.21.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
